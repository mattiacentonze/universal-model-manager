#!/usr/bin/env bash
#
# pre-commit hook for universal-model-manager
#
# Workflow (runs on every commit):
#   1. biome check --write  -> auto-fix formatting/lint/imports on staged files
#   2. re-stage the fixed files
#   3. npm test             -> run the test suite
#   4. if tests fail, invoke an AI model (opencode run) to analyze the failure
#      and fix the source; then re-run the tests
#   5. abort the commit if checks still fail
#
# The hook is idempotent: it never commits by itself, so re-running `git commit`
# re-triggers this hook until all checks pass.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------
log()  { printf '\033[1;34m[pre-commit]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[pre-commit]\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[pre-commit]\033[0m %s\n' "$*"; }

# Skip the whole hook when explicitly requested (e.g. --no-verify already
# bypasses hooks, but this is an extra escape hatch for CI/scripts).
if [ "${UMM_SKIP_PRECOMMIT:-0}" = "1" ]; then
  log "UMM_SKIP_PRECOMMIT=1, skipping pre-commit checks."
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. biome check --write on staged files
# ---------------------------------------------------------------------------
STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|mjs|jsx|json)$' || true)"

if [ -n "$STAGED" ]; then
  log "Running biome check --write on staged files..."
  if ! npx @biomejs/biome check --write $STAGED >/tmp/umm-biome.log 2>&1; then
    warn "biome reported issues (see /tmp/umm-biome.log). Re-staging fixed files."
  fi
  # Re-stage anything biome changed
  git add $STAGED 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# 2. typecheck
# ---------------------------------------------------------------------------
log "Running typecheck..."
if ! npm run typecheck >/tmp/umm-typecheck.log 2>&1; then
  fail "Typecheck failed. See /tmp/umm-typecheck.log"
  exit 1
fi

# ---------------------------------------------------------------------------
# 3. tests (with AI-driven fix loop)
# ---------------------------------------------------------------------------
run_tests() {
  npm test >/tmp/umm-test.log 2>&1
}

log "Running tests..."
if run_tests; then
  log "All checks passed."
  exit 0
fi

# Tests failed. Invoke the AI model to analyze and fix.
warn "Tests failed. Invoking AI model to analyze and fix..."

AI_PROMPT="You are the pre-commit AI reviewer for the universal-model-manager repository at $ROOT.

The test suite just failed. Your job:
1. Read /tmp/umm-test.log to understand exactly which tests failed and why.
2. Read /tmp/umm-biome.log and /tmp/umm-typecheck.log if present.
3. Analyze the root cause. The failure may have been introduced by recent biome auto-fixes, a refactor, or a genuine bug.
4. Fix the source code (NOT the tests, unless the test itself is wrong) so the failing tests pass.
5. Do NOT commit, do NOT push, do NOT run git commands. Only edit files.
6. After fixing, run 'npm test' yourself to confirm the fix works. Iterate until the failing tests pass.

Report concisely what you found and what you changed."

if command -v opencode >/dev/null 2>&1; then
  if opencode run --dir "$ROOT" "$AI_PROMPT" >/tmp/umm-ai.log 2>&1; then
    log "AI fix pass completed. Re-running tests..."
    if run_tests; then
      log "Tests pass after AI fix."
      # Re-stage any files the AI changed
      git add -u 2>/dev/null || true
      exit 0
    fi
    fail "Tests still failing after AI fix. See /tmp/umm-test.log and /tmp/umm-ai.log"
    exit 1
  else
    fail "AI model invocation failed. See /tmp/umm-ai.log"
    exit 1
  fi
else
  fail "Tests failed and 'opencode' CLI is not available for AI review. See /tmp/umm-test.log"
  exit 1
fi

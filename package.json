{
  "name": "universal-model-manager",
  "version": "0.1.0",
  "description": "Unified model manager for OpenCode: CortexKit OpenAI/ChatGPT OAuth + Antigravity auth, web bridge, runtime fallback, delegation router, resumable wizard, and unified TUI sidebar.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "universal-model-manager": "./dist/cli.js",
    "umm": "./dist/cli.js",
    "universal-auth": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./openai": {
      "import": "./dist/openai/index.js",
      "types": "./dist/openai/index.d.ts"
    },
    "./antigravity": {
      "import": "./dist/antigravity/index.js",
      "types": "./dist/antigravity/index.d.ts"
    },
    "./fallback": {
      "import": "./dist/fallback/index.js",
      "types": "./dist/fallback/index.d.ts"
    },
    "./chatgpt-web": {
      "import": "./dist/chatgpt-web/index.js",
      "types": "./dist/chatgpt-web/index.d.ts"
    },
    "./tui": {
      "import": "./src/tui/entry.mjs",
      "types": "./dist/tui.d.ts"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "files": [
    "dist",
    "src/tui",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "checks": "npm run typecheck",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.1.0"
  },
  "dependencies": {
    "@cortexkit/antigravity-auth-core": "^2.2.1",
    "@cortexkit/opencode-antigravity-auth": "^2.2.1",
    "@cortexkit/opencode-openai-auth": "^0.7.1",
    "jsonc-parser": "^3.3.1",
    "opencode-runtime-fallback": "^0.2.4",
    "playwright-core": "^1.50.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

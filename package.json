{
  "name": "universal-model-manager",
  "version": "0.1.0",
  "description": "Unified model manager for OpenCode: CortexKit OpenAI/ChatGPT OAuth + Antigravity auth, web bridge, runtime fallback, delegation router, resumable wizard, and unified TUI sidebar.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "universal-model-manager": "./dist/cli.js",
    "umm": "./dist/cli.js",
    "universal-auth": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./openai": {
      "import": "./dist/openai/index.js",
      "types": "./dist/openai/index.d.ts"
    },
    "./antigravity": {
      "import": "./dist/antigravity/index.js",
      "types": "./dist/antigravity/index.d.ts"
    },
    "./fallback": {
      "import": "./dist/fallback/index.js",
      "types": "./dist/fallback/index.d.ts"
    },
    "./chatgpt-web": {
      "import": "./dist/chatgpt-web/index.js",
      "types": "./dist/chatgpt-web/index.d.ts"
    },
    "./tui": {
      "import": "./src/tui/entry.mjs",
      "types": "./dist/tui.d.ts"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "files": [
    "dist",
    "vendor",
    "src/tui",
    "src/tui-compiled",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\" && rm -rf dist/vendor && cp -r vendor dist/vendor && mkdir -p dist/model-router && cp src/model-router/tiers.json dist/model-router/tiers.json && npm run build:tui",
    "build:tui": "node scripts/build-tui.mjs",
    "typecheck": "tsc --noEmit",
    "checks": "npm run typecheck",
    "test": "vitest run",
    "test:clicks": "bun test --conditions browser ./tests/clicks.bun.spec.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.1.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "ai": "^7.0.95",
    "jsonc-parser": "^3.3.1",
    "playwright-core": "^1.50.0",
    "solid-js": "^1.9.12",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
